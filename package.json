{
  "name": "clu",
  "productName": "CLU",
  "version": "0.1.0",
  "description": "CLU - a sci-fi terminal desktop environment. Command line first, app when you need it.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "CLU",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "start": "node build.mjs && electron .",
    "dev": "node build.mjs && electron . --windowed --nointro",
    "dist": "node build.mjs && electron-builder --win --x64",
    "dist:dir": "node build.mjs && electron-builder --win --x64 --dir",
    "icon": "electron scripts/make-icon.cjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "systeminformation": "^5.33.19"
  },
  "devDependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "d3-geo": "^3.1.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "build": {
    "appId": "dev.clu.app",
    "productName": "CLU",
    "npmRebuild": false,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "src/main/**",
      "src/preload/**",
      "src/shell/**",
      "dist/**",
      "package.json"
    ],
    "asarUnpack": [
      "src/shell/**",
      "node_modules/node-pty/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
